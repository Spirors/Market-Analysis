# Copy to .env and fill in. .env is gitignored; this example is committed.
#
# The app runs fully without any key: every keyed path degrades to null/— instead
# of erroring. Only the in-app topic-drafting agent (app/topic_agent.py) needs
# this, and it reports the missing key explicitly rather than failing silently.

# OpenCode Go API key - https://opencode.ai/zen/go
# Used by the bottleneck topic-drafting agent. Note the host is /zen/go/v1/...,
# which is a different endpoint family from Zen's /zen/v1/....
OPENCODE_GO_API_KEY=
